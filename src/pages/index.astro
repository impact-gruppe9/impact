<h1>MUSIC // ART // TALKS // WORKSHOP // FOOD <br /> DESIGNED TO INCREASE OUR IMPACT</h1>
<a target="_blank" href="https://www.billetsalg.dk/Ticket/IMPACT%20FESTIVAL%202026/9545">TICKETS</a>
<section id="gallery">
   
    
    <Card 
    title="TALKS"
    bgimage="talks.webp" 
    />
    
    <Card 
    title="WORKSHOPS"
    bgimage="workshop.webp" 
    />
    
    <Card 
    title="MUSIC"
    bgimage="musik.webp" 
    />
    
    <Card 
    title="ART"
    bgimage="Art.webp" 
    />
    
</section>

</Layout>

